  "simplification_mapping": {
    "description": "将行业术语映射为本体标准实体，确保跨材料统一表达",
    "power_mapping": {
      "Substation": "Bus",
      "PowerPlant": "Generator (on Bus)",
      "TransmissionLine": "Branch",
      "DistributionLine": "Branch",
      "Transformer": "Branch (impedance attribute)",
      "Breaker": "Branch (on/off state attribute)",
      "CapacitorBank": "Bus (reactive_injection attribute)"
    },
    "water_mapping": {
      "PumpStation": "Pump + POWERED_BY→Bus",
      "WaterTreatmentPlant": "Node_Junction (type=source)",
      "IntakePumpStation": "Pump (type=intake) + POWERED_BY→Bus",
      "BoosterPumpStation": "Pump (type=booster) + POWERED_BY→Bus",
      "DrainagePumpStation": "Pump (type=drainage) + POWERED_BY→Bus",
      "Pipeline": "Pipe_Link",
      "Valve": "Pipe_Link (valve_state attribute) or Valve entity",
      "Tank_Reservoir": "Tank",
      "Hydrant": "Node_Junction (type=demand)",
      "Well": "Node_Junction (type=well)",
      "Reservoir": "Node_Junction (type=reservoir) or Tank"
    },
    "cyber_mapping": {
      "SCADA_Server": "CyberNode (type=scada) or SCADA",
      "PLC": "CyberNode (type=plc)",
      "RTU": "CyberNode (type=rtu)",
      "PMU": "CyberNode (type=pmu)",
      "Sensor": "CyberNode (type=sensor)",
      "Actuator": "CyberNode (type=actuator)",
      "FiberLink": "CyberEdge (type=fiber) or CONNECTS_TO(layer_type=cyber_comm)",
      "WirelessLink": "CyberEdge (type=wireless) or CONNECTS_TO(layer_type=cyber_comm)"
    },
    "station_node_bidirectional": {
      "rule": "Substation CONTAINS Bus; PumpStation CONTAINS Pump; PowerPlant CONTAINS Generator",
      "description": "站级实体与节点级实体通过CONTAINS关系双向映射，支持跨粒度查询",
      "neo4j_example": "MATCH (ps:PumpStation)-[:CONTAINS]->(p:Pump)-[:POWERED_BY]->(b:Bus)<-[:CONTAINS]-(ss:Substation)"
    }
  },
  "material_extraction_strategies": {
    "M1_academic_paper": {
      "entity_granularity": "L4-node",
      "entity_types": [
        "Bus",
        "Branch",
        "Generator",
        "Pump",
        "Node_Junction",
        "Pipe_Link",
        "Tank",
        "CyberNode",
        "CyberEdge"
      ],
      "relation_explicitness": "R3-formula / R4-probabilistic",
      "attribute_precision": "A4-simulation (pu values, model parameters)",
      "key_extracts": [
        "POWERED_BY mapping table (Pump→Bus)",
        "Network topology (adjacency matrix)",
        "Simulation model type and parameters",
        "Cascade simulation results (load_shedding, pressure_satisfaction)",
        "Resilience index formula and values"
      ],
      "extraction_prompt_focus": "Extract node-level entities with IDs (Bus-1, Pump-3), topology connections, and POWERED_BY mapping. Capture simulation parameters in pu units.",
      "cascade_expression": "model (DC flow + EPANET coupled simulation)"
    },
    "M2_report": {
      "entity_granularity": "L2-station",
      "entity_types": [
        "Substation→Bus",
        "PumpStation→Pump",
        "WaterTreatmentPlant→Node_Junction",
        "PowerPlant→Generator",
        "HazardType"
      ],
      "relation_explicitness": "R1-qualitative",
      "attribute_precision": "A1-A2 (qualitative, statistics)",
      "key_extracts": [
        "System-level dependency descriptions (water depends on power)",
        "Hazard category and historical statistics",
        "Research gaps and policy recommendations",
        "Backup power type mentions"
      ],
      "extraction_prompt_focus": "Extract station-level entities with names (XX变电站, XX泵站). Capture qualitative dependency descriptions. Map to canonical entity names.",
      "cascade_expression": "narrative (causal chain without formula)"
    },
    "M3_standard": {
      "entity_granularity": "L2-station + L3-device",
      "entity_types": [
        "PumpStation→Pump",
        "Pump",
        "Valve",
        "BackupPower",
        "SCADA"
      ],
      "relation_explicitness": "R1-qualitative-requirement / R1-qualitative-mandatory",
      "attribute_precision": "A3-rated (design parameters, safety thresholds)",
      "key_extracts": [
        "Mandatory requirements (N-1, backup power, SCADA monitoring)",
        "Safety thresholds (Kp>=1.05, leak_rate<=12%)",
        "Design parameters (pump rated power/head/flow, pipe diameter)",
        "Facility classification (station grade)"
      ],
      "extraction_prompt_focus": "Extract mandatory requirements with SHALL/MUST keywords. Capture rated parameters and safety thresholds. Distinguish requirement from recommendation.",
      "cascade_expression": "requirement (must prevent cascading failure)"
    },
    "M4_emergency_plan": {
      "entity_granularity": "L2-station",
