      "extraction_prompt_focus": "Extract complete cascade chain with timeline and impact data. Capture AMPLIFIES feedback loops. Reconstruct implicit dependencies from event narrative.",
      "cascade_expression": "narrative (complete event timeline with impact)"
    }
  },
  "neo4j_constraints": {
    "unique_constraints": [
      "CREATE CONSTRAINT IF NOT EXISTS FOR (b:Bus) REQUIRE b.id IS UNIQUE",
      "CREATE CONSTRAINT IF NOT EXISTS FOR (p:Pump) REQUIRE p.id IS UNIQUE",
      "CREATE CONSTRAINT IF NOT EXISTS FOR (g:Generator) REQUIRE g.id IS UNIQUE",
      "CREATE CONSTRAINT IF NOT EXISTS FOR (n:Node_Junction) REQUIRE n.id IS UNIQUE",
      "CREATE CONSTRAINT IF NOT EXISTS FOR (br:Branch) REQUIRE br.id IS UNIQUE",
      "CREATE CONSTRAINT IF NOT EXISTS FOR (pl:Pipe_Link) REQUIRE pl.id IS UNIQUE",
      "CREATE CONSTRAINT IF NOT EXISTS FOR (t:Tank) REQUIRE t.id IS UNIQUE",
      "CREATE CONSTRAINT IF NOT EXISTS FOR (cn:CyberNode) REQUIRE cn.id IS UNIQUE",
      "CREATE CONSTRAINT IF NOT EXISTS FOR (ht:HazardType) REQUIRE ht.name IS UNIQUE",
      "CREATE CONSTRAINT IF NOT EXISTS FOR (sc:SCADA) REQUIRE sc.id IS UNIQUE",
      "CREATE CONSTRAINT IF NOT EXISTS FOR (bp:BackupPower) REQUIRE bp.id IS UNIQUE"
    ],
    "relationship_constraints": {
      "POWERED_BY": "ONLY from Pump to Bus",
      "CASCADES_TO": "ONLY between physical layer entities (Bus, Pump, Generator, Node_Junction)",
      "TRIGGERS": "ONLY from HazardType to physical layer entities",
      "CONTROLS": "ONLY from SCADA/CyberNode to physical layer entities",
      "MONITORS": "ONLY from SCADA/CyberNode to physical layer entities",
      "CONNECTS_TO": "ONLY between same-layer entities",
      "HAS_BACKUP": "ONLY from Pump/Bus to BackupPower"
    }
  },
  "core_cascade_paths": {
    "canonical_path": "HazardType -[:TRIGGERS]-> Bus -[:CASCADES_TO]-> Pump -[:CASCADES_TO]-> Node_Junction",
    "power_to_water": "Bus fault → Pump POWERED_BY loss → Node_Junction pressure drop",
    "full_chain_with_cyber": "HazardType -[:TRIGGERS]-> SCADA -[:CONTROLS]-> Bus -[:CASCADES_TO]-> Pump -[:CASCADES_TO]-> Node_Junction",
    "resilience_intervention": "Pump -[:HAS_BACKUP]-> BackupPower (prevents POWERED_BY loss)",
    "amplification_loop": "Bus -[:AMPLIFIES]-> Pump -[:AMPLIFIES]-> Bus (positive feedback)",
    "neo4j_query_example": "MATCH path=(h:HazardType)-[:TRIGGERS]->(b:Bus)-[:CASCADES_TO*1..3]->(n:Node_Junction) RETURN path"
  },
  "v1_to_v2_changes": {
    "deleted_entities": [
      "coordinates (C6: no material can extract)",
      "ip_address (C6: no material can extract)",
      "firmware_version (C6: no material can extract)",
      "PLC/RTU/PMU/Sensor/Actuator (C3: merged into CyberNode with type attribute)",
      "FiberLink/WirelessLink (C3: merged into CyberEdge or CONNECTS_TO)"
    ],
    "added_entities": [
      "BackupPower (M3/M4 unique, resilience key)",
      "SCADA (promoted from mention to entity, 4 materials)",
      "WaterSystem (M4/M5 system-level entity)",
      "NaturalGasFacility (M2/M5 extended infrastructure)",
      "ResponseLevel (M4 emergency response)"
    ],
    "promoted_relations": [
      "CONTROLS: keep→required (4 materials after M3 SCADA requirement added)",
      "CASCADES_TO: keep→required (4 materials confirmed)"
    ],
    "key_principle_change": "v1.0 was top-down (prior knowledge), v2.0 is bottom-up (material evidence). Only entities/relations/attributes that can be extracted from >=1 material type are retained."
  },
