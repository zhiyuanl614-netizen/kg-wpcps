      "key_extracts": [
        "NAMED facility interdependency (XX泵站由XX变电站供电)",
        "Backup power details (type, duration, capacity)",
        "Response level classification (I/II/III/IV)",
        "Cascade chain narrative (qualitative causal chain)"
      ],
      "extraction_prompt_focus": "Extract NAMED facility mappings with specific station names. Capture backup power details. Map station names to canonical entities.",
      "cascade_expression": "narrative (planned response chain)"
    },
    "M5_event": {
      "entity_granularity": "L2-station",
      "entity_types": [
        "Substation→Bus",
        "PumpStation→Pump",
        "HazardType",
        "SCADA",
        "NaturalGasFacility"
      ],
      "relation_explicitness": "R0-implicit / R1-narrative",
      "attribute_precision": "A1-qualitative (impact statistics)",
      "key_extracts": [
        "COMPLETE cascade chain with timeline",
        "Impact statistics (population, MW lost, recovery time)",
        "AMPLIFIES positive feedback loops",
